<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-direction: row; align-content: center; justify-content: center; flex-shrink: 1; flex-basis: initial; position: relative; width: 100%; height: 100%; align-self: center; align-items: flex-end; background-size: 100% 100%; flex-wrap: nowrap; min-width: initial; min-height: initial; -unity-background-scale-mode: scale-to-fit;">
        <ui:VisualElement name="Speedometer" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Sprites/UI%20speedometer.png?fileID=2800000&amp;guid=17c5e66f74983654facb642912dc594d&amp;type=3#UI speedometer&quot;); background-size: contain; flex-shrink: 0; align-items: center; align-content: flex-start; height: 7.92%; width: 7.92%; align-self: auto; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(255, 255, 255); color: rgb(255, 255, 255); background-color: rgba(255, 255, 255, 0); min-width: 152px; min-height: 150px; flex-basis: 0; margin-top: 0%; margin-right: 2.5%; margin-bottom: 0%; margin-left: 0%;">
