            </ui:Tab>
            <ui:Tab label="graphics" name="Tab" style="flex-grow: 1; background-color: rgba(255, 255, 255, 0);">
                <ui:VisualElement name="GraphicsContainer" enabled="true" style="flex-grow: 1; width: auto; flex-direction: row; align-items: center; align-content: center; justify-content: center; align-self: flex-start; opacity: 1;">
                    <ui:VisualElement name="LabelContainer" style="flex-grow: 0; align-self: center; align-items: flex-start; justify-content: flex-start; align-content: center; flex-direction: column;">
                        <ui:Label text="Resolution" style="-unity-font-definition: url(&quot;project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=585188cdc4600544eb408bee749e4b3a&amp;type=3#ThaleahFat_TTF&quot;); color: rgb(255, 255, 255); font-size: 60px; align-items: auto; align-content: auto; height: 64px; align-self: center; white-space: normal;" />
                        <ui:Label text=" SCREEN MODE" style="-unity-font-definition: url(&quot;project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=585188cdc4600544eb408bee749e4b3a&amp;type=3#ThaleahFat_TTF&quot;); color: rgb(255, 255, 255); font-size: 60px; align-self: flex-start; align-items: auto; align-content: center; height: 64px; justify-content: center; flex-shrink: 1; white-space: normal;" />
                        <ui:Label text="Quality" style="-unity-font-definition: url(&quot;project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=585188cdc4600544eb408bee749e4b3a&amp;type=3#ThaleahFat_TTF&quot;); color: rgb(255, 255, 255); font-size: 60px; align-self: flex-start; align-items: auto; align-content: center; height: 64px; justify-content: center; flex-shrink: 1; white-space: normal;" />
                        <ui:Label text="V-SYNC" style="-unity-font-definition: url(&quot;project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=585188cdc4600544eb408bee749e4b3a&amp;type=3#ThaleahFat_TTF&quot;); color: rgb(255, 255, 255); font-size: 60px; align-self: center; align-items: auto; align-content: center; height: 64px; justify-content: center; flex-shrink: 1; white-space: normal;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="GraphicsSettingsContainer" style="align-items: stretch; flex-direction: column;">
                        <ui:DropdownField index="0" name="ResolutionDropdown" style="width: 255px; background-color: rgba(255, 255, 255, 0); display: flex; height: 60px;" />
                        <ui:DropdownField name="ScreenDropdown" style="height: 60px; width: 255px;" />
                        <ui:DropdownField name="QualityDropdown" style="height: 60px; width: 255px;" />
                        <ui:Toggle name="VSYNC" style="align-self: center; align-content: center; margin-top: 2px; height: 60px; margin-bottom: 2px; flex-direction: row; align-items: center; flex-wrap: nowrap; flex-grow: 1; overflow: hidden;" />
