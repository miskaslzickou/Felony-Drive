<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/SettingsStyle.uss?fileID=7433441132597879392&amp;guid=52084936ad97952409a0578543cdaa63&amp;type=3#SettingsStyle" />
    <ui:VisualElement name="BodyContainer" style="flex-grow: 0; background-color: rgba(255, 255, 255, 0); align-self: center; align-content: center; justify-content: center; align-items: center; flex-direction: column; height: auto; width: auto; display: flex;">
        <ui:Label text="Settings" name="Label" style="font-size: 140px; -unity-font-definition: url(&quot;project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=585188cdc4600544eb408bee749e4b3a&amp;type=3#ThaleahFat_TTF&quot;); color: rgb(255, 255, 255); -unity-font-style: normal; align-self: center; align-items: center; align-content: center; justify-content: center; -unity-text-align: upper-left; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0);" />
        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
