            <ui:Tab label="AUDIO" name="Tab" style="flex-grow: 1; background-color: rgba(255, 255, 255, 0);">
                <ui:VisualElement name="AudioContainer" enabled="true" style="flex-grow: 1; width: auto; flex-direction: row; align-items: center; align-content: center; justify-content: center; align-self: flex-start; opacity: 1; display: flex;">
                    <ui:VisualElement style="flex-grow: 0; align-self: flex-start; align-items: flex-start;">
