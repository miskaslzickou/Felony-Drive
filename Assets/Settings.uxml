                        <ui:Label text="SFX" style="-unity-font-definition: url(&quot;project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=585188cdc4600544eb408bee749e4b3a&amp;type=3#ThaleahFat_TTF&quot;); color: rgb(255, 255, 255); font-size: 60px;" />
                        <ui:Label text="MUSIC" style="-unity-font-definition: url(&quot;project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=585188cdc4600544eb408bee749e4b3a&amp;type=3#ThaleahFat_TTF&quot;); color: rgb(255, 255, 255); font-size: 60px;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="SliderContainer" style="align-items: stretch;">
                        <ui:Slider value="1" high-value="1" fill="false" name="Master" low-value="0.001" style="width: 255px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=585188cdc4600544eb408bee749e4b3a&amp;type=3#ThaleahFat_TTF&quot;); font-size: 60px; height: 60px; align-self: center;" />
                        <ui:Slider value="1" high-value="1" fill="false" name="SFX" low-value="0.001" style="width: 255px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=585188cdc4600544eb408bee749e4b3a&amp;type=3#ThaleahFat_TTF&quot;); font-size: 60px; height: 60px;" />
                        <ui:Slider value="100" high-value="1" fill="false" name="Music" low-value="0.001" style="width: 255px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=585188cdc4600544eb408bee749e4b3a&amp;type=3#ThaleahFat_TTF&quot;); font-size: 60px; height: 60px;" />
                    </ui:VisualElement>
