        </ui:VisualElement>
        <ui:TabView tabindex="0" style="background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255); color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=585188cdc4600544eb408bee749e4b3a&amp;type=3#ThaleahFat_TTF&quot;); font-size: 40px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
            <ui:Tab label="KEYBINDS" name="Tab" style="flex-grow: 1; background-color: rgba(255, 255, 255, 0);">
                <ui:VisualElement name="KeysParent" style="flex-grow: 1; flex-direction: column;" />
